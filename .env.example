# Hanya untuk alat lokal. File .env tidak boleh diunggah ke GitHub/hosting.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Akun admin pertama; isi password sendiri sebelum npm run setup:admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Untuk alat migrasi awal. Jadwal otomatis memakai URL privat di dashboard_sync.settings.
LEGACY_SHEET_URL=
